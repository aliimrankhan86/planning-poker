{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^12.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "node scripts/gen-ai-context.mjs && node scripts/gen-sitemap.mjs && react-scripts build && node scripts/prerender.mjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:rules": "node scripts/build-rules.mjs",
    "test:rules": "node scripts/build-rules.mjs && PATH=\"$(/usr/libexec/java_home -v 21 2>/dev/null)/bin:$PATH\" npx --yes firebase-tools emulators:exec --only database --project demo-pointpoker 'node scripts/rules-test.mjs'",
    "prerender": "node scripts/prerender.mjs",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "docs": "node scripts/gen-ai-context.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.test.js"
        ],
        "rules": {
          "testing-library/no-node-access": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}

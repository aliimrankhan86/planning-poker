{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "pointpoker.app" }
      ],
      "destination": "https://www.pointpoker.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/t/:slug",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "//": "Owner-only. It is not prerendered, so Vercel falls back to the home document — which carries robots: index, follow. App.js does rewrite that to noindex, but only once React has hydrated, so every crawler that does not run JS was being told to index it. Same header the team-room path already uses.",
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/t/:slug", "destination": "/" }
  ]
}

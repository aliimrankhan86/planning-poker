{
  "headers": [
    {
      "source": "/t/:slug",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/t/:slug",  "destination": "/" },
    { "source": "/terms",    "destination": "/" },
    { "source": "/privacy",  "destination": "/" }
  ]
}

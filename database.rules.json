{
  "rules": {
    "rooms": {
      // sweepStaleRooms queries rooms by age instead of downloading the whole
      // node. Without this index Firebase sorts on the client, which means it
      // ships every room to every visitor anyway and logs a warning.
      ".indexOn": ["createdAt"],

      "$roomId": {
        // ── READ ──────────────────────────────────────────────────────────
        // Anyone with the room code can read. Security is the code itself
        // (random 5-char base-36 = ~60M combinations for free rooms;
        //  team rooms use a slug derived from the team name).
        ".read": true,

        // ── WRITE ─────────────────────────────────────────────────────────
        // Room participation stays auth-optional so guests can join instantly.
        // Writes remain open at room paths, but data integrity and Pro-room
        // creation constraints are enforced by the validation rules below.
        ".write": true,

        // ── ROOT VALIDATION ───────────────────────────────────────────────
        // On initial room creation all required top-level fields must be present.
        // On subsequent updates the room already exists so newData always has them.
        //
        // Note the coupling this creates, because it is not obvious and it is
        // load-bearing: requiring 'players' means REMOVING THE LAST PLAYER IS
        // REJECTED — the write would leave the room without the node. leaveRoom
        // already deletes the whole room when it is the last one out, and
        // onDisconnect only marks a player offline, so nothing in the app hits
        // it. Anything that ever removes a player unconditionally will, and it
        // will fail silently inside an onDisconnect the client never hears back
        // from. Verified against the emulator; see scripts/rules-test.mjs.
        ".validate": "newData.hasChildren(['createdAt', 'revealed', 'round', 'plan', 'deck', 'players', 'timer'])",

        // ── FIELD VALIDATION ──────────────────────────────────────────────

        // Every room is free. The field is kept because the root .validate
        // requires it and rooms already in the database carry it; the paid
        // branch that used to live here is gone along with the paid tier.
        "plan": {
          ".validate": "newData.isString() && newData.val() === 'free'"
        },

        "deck": {
          ".validate": "newData.isString() && (newData.val() === 'fibonacci' || newData.val() === 'tshirt' || newData.val() === 'powers') && (!data.exists() || newData.val() === data.val())"
        },

        "revealed": {
          ".validate": "newData.isBoolean()"
        },

        "round": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },

        "storiesDone": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "streak": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "consensusCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "activeStory": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        // serverTimestamp() resolves to a number before validation runs —
        // the string 'SERVER_TIMESTAMP' is never seen by the rules engine.
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },

        "teamName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 60 && (!data.exists() || newData.val() === data.val()))"
        },

        "founderRoom": {
          ".validate": "!newData.exists() || (newData.isBoolean() && (!data.exists() ? newData.val() === ($roomId === 'rpa-build-team' || $roomId === 'rpa-discovery-team') : newData.val() === data.val()))"
        },

        // Write-once: set at room creation, cannot be changed mid-session.
        "estimationMode": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'stories' || newData.val() === 'tasks') && (!data.exists() || newData.val() === data.val()))"
        },

        // ── PLAYERS ───────────────────────────────────────────────────────
        "players": {
          "$playerId": {
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren(['id', 'name', 'role', 'voted'])",

            "id":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val() === $playerId" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "role": { ".validate": "newData.isString() && (newData.val() === 'voter' || newData.val() === 'observer')" },
            "vote": {
              ".validate": "!newData.exists() || (newData.isString() && (newData.val() === '?' || (newData.parent().parent().parent().child('deck').val() === 'fibonacci' && (newData.val() === '1' || newData.val() === '2' || newData.val() === '3' || newData.val() === '5' || newData.val() === '8' || newData.val() === '13' || newData.val() === '21' || newData.val() === '34')) || (newData.parent().parent().parent().child('deck').val() === 'tshirt' && (newData.val() === 'XS' || newData.val() === 'S' || newData.val() === 'M' || newData.val() === 'L' || newData.val() === 'XL' || newData.val() === 'XXL')) || (newData.parent().parent().parent().child('deck').val() === 'powers' && (newData.val() === '1' || newData.val() === '2' || newData.val() === '4' || newData.val() === '8' || newData.val() === '16' || newData.val() === '32'))))"
            },
            "voted": { ".validate": "newData.isBoolean()" },
            "online": { ".validate": "!newData.exists() || newData.isBoolean()" },
            "disconnectedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        // ── TIMER ─────────────────────────────────────────────────────────
        // No hasChildren() here — the app makes partial updates to timer
        // sub-fields (e.g. timer/remaining only). Validate each field
        // independently so partial writes don't fail validation.
        "timer": {
          "running":   { ".validate": "newData.isBoolean()" },
          "duration":  { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 300" },
          "remaining": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "startedBy": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 40)" },
          "$other": { ".validate": false }
        },

        // ── STORIES ───────────────────────────────────────────────────────
        // $storyIndex is the array position, so constraining its FORMAT is
        // what caps the list — there is no other way to bound a child count
        // here, and this path takes unauthenticated writes. Three digits is
        // 1000 items, which is more backlog than a room can work through and
        // 200KB at the per-name cap; without it one request could seed
        // stories/999999999 and there was no ceiling at all.
        // It is a correctness rule too: the client reads this node with
        // Object.values() and sorts rounds numerically, so a non-numeric key
        // injected here becomes a nameless story in the queue and a NaN in
        // the sort.
        "stories": {
          "$storyIndex": {
            ".write": true,
            ".validate": "$storyIndex.matches(/^[0-9]{1,3}$/) && (!newData.exists() || newData.hasChildren(['name']))",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "estimate": {
              ".validate": "!newData.exists() || (newData.isString() && (newData.val() === '?' || (newData.parent().parent().parent().child('deck').val() === 'fibonacci' && (newData.val() === '1' || newData.val() === '2' || newData.val() === '3' || newData.val() === '5' || newData.val() === '8' || newData.val() === '13' || newData.val() === '21' || newData.val() === '34')) || (newData.parent().parent().parent().child('deck').val() === 'tshirt' && (newData.val() === 'XS' || newData.val() === 'S' || newData.val() === 'M' || newData.val() === 'L' || newData.val() === 'XL' || newData.val() === 'XXL')) || (newData.parent().parent().parent().child('deck').val() === 'powers' && (newData.val() === '1' || newData.val() === '2' || newData.val() === '4' || newData.val() === '8' || newData.val() === '16' || newData.val() === '32'))))"
            },
            "$other": { ".validate": false }
          }
        },

        // ── ROUNDS ────────────────────────────────────────────────────────
        // Per-round estimates recorded by newRound (no-queue path).
        // Keyed by storiesDone index at the time of recording. Same three-digit
        // key cap as stories, for the same two reasons.
        "rounds": {
          "$roundIndex": {
            ".write": true,
            ".validate": "$roundIndex.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['estimate', 'isConsensus'])",
            "estimate": {
              ".validate": "newData.isString() && (newData.val() === '?' || (newData.parent().parent().parent().child('deck').val() === 'fibonacci' && (newData.val() === '1' || newData.val() === '2' || newData.val() === '3' || newData.val() === '5' || newData.val() === '8' || newData.val() === '13' || newData.val() === '21' || newData.val() === '34')) || (newData.parent().parent().parent().child('deck').val() === 'tshirt' && (newData.val() === 'XS' || newData.val() === 'S' || newData.val() === 'M' || newData.val() === 'L' || newData.val() === 'XL' || newData.val() === 'XXL')) || (newData.parent().parent().parent().child('deck').val() === 'powers' && (newData.val() === '1' || newData.val() === '2' || newData.val() === '4' || newData.val() === '8' || newData.val() === '16' || newData.val() === '32')))"
            },
            "isConsensus": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    // ── ADMINS ────────────────────────────────────────────────────────────
    // Allowlist for the owner-only usage dashboard. Write is denied to every
    // client: entries are added by hand in the Firebase console, so nobody can
    // promote themselves. A uid can read its own entry to show a clear message.
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // ── ANALYTICS ─────────────────────────────────────────────────────────
    // Anonymous daily usage counters: /analytics/daily/{YYYY-MM-DD}/{event}
    // → integer. No user IDs, no room codes, nothing that identifies a person.
    //
    // These numbers decide whether the product is worth continuing, so the
    // write rule has to make forging them expensive. Clients may only step a
    // counter up by exactly one, which is what set(ref, increment(1)) does —
    // increment resolves server-side before validation, the same way
    // serverTimestamp() does. Anything else is rejected:
    //   • setting a counter to 999999 in one write
    //   • resetting a counter to 0 to erase a day
    //   • inventing event names to clutter the dashboard
    //   • writing to a date that is not a plausible calendar day
    // Faking a number now costs one request per unit, which is the same effort
    // as generating the real usage.
    "analytics": {
      // Aggregate integer counters only, but read is still restricted so
      // competitors cannot scrape volume.
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "daily": {
        "$date": {
          "$event": {
            ".write": true,
            ".validate": "$date.matches(/^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && $event.matches(/^[a-z][a-z0-9_]{2,39}$/) && newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
          }
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        // The paid tier is gone, so the licence cross-reference that used to
        // gate this is gone with it. plan/billingStatus survive only as legacy
        // fields on accounts created before the pivot: they are accepted so an
        // old profile can still be saved, and they no longer grant anything.
        ".validate": "newData.hasChildren(['email', 'displayName', 'teamRoomName', 'createdAt', 'lastLoginAt']) && (!newData.child('teamRooms').exists() || (newData.child('teamRooms').child('primary').val() === newData.child('teamRoomName').val() && newData.child('teamRooms').child('secondary').val() !== newData.child('teamRooms').child('primary').val()))",

        // Shape-checked, not just length-checked, because this string leaves
        // the database: notifyOwnerOnSignup puts it in a mail subject line.
        // The HTML body is escaped and nodemailer neutralises header injection,
        // so this is the belt to that pair of braces — but a field that reaches
        // an SMTP header should not be able to hold a newline in the first
        // place, and a length cap alone let it.
        // An allowlist rather than a ban on control characters: the rules
        // engine has no \s class (it rejects the pattern outright), and
        // enumerating what may appear is the safer direction anyway. This is
        // the common address shape — plus-addressing and multi-label domains
        // included. The rare RFC 5322 local-part punctuation (!#$%&'*/=?^`{|}~)
        // is not in it, so an address using one could not save a profile.
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,24}$/)"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "teamRoomName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "teamRooms": {
          ".validate": "!newData.exists() || newData.hasChildren(['primary', 'secondary'])",
          "primary": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "secondary": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60 && newData.val() !== newData.parent().child('primary').val()"
          },
          "$other": {
            ".validate": false
          }
        },
        "plan": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "billingStatus": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "billingCycle": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'monthly' || newData.val() === 'annual'))"
        },
        "currency": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'GBP' || newData.val() === 'USD' || newData.val() === 'EUR'))"
        },
        "proKey": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length === 19)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastLoginAt": {
          ".validate": "newData.isNumber()"
        },
        "checkoutStartedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "proActivatedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // The "licenses" node is deliberately absent. It backed the pre-Stripe Pro
    // entitlement store, no code has referenced it since the product went free,
    // and it granted every authenticated user read access to any licence key
    // they could guess. It now falls through to the $other deny-all below.

    // ── SPRINT HISTORY ────────────────────────────────────────────────────────
    // Per-user session records written by saveSessionHistory() on session end.
    // Only the owning authenticated user can read or write their history.
    // Each entry is keyed by push() auto-ID; no custom path manipulation possible.
    "history": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "$entryId": {
          ".validate": "newData.hasChildren(['roomCode', 'startedAt', 'endedAt', 'storiesDone', 'totalPoints', 'consensusRate']) && newData.child('endedAt').isNumber() && newData.child('startedAt').isNumber() && newData.child('endedAt').val() >= newData.child('startedAt').val()",

          "roomCode":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48" },
          "teamName":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
          "startedAt":     { ".validate": "newData.isNumber()" },
          "endedAt":       { ".validate": "newData.isNumber()" },
          "storiesDone":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalPoints":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "consensusRate": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "storyCount":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "stories": {
            "$si": {
              ".validate": "newData.hasChildren(['name', 'estimate'])",
              "name":     { ".validate": "newData.isString() && newData.val().length <= 200" },
              "estimate": { ".validate": "newData.isString()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },

    // Block all reads/writes to any path not explicitly defined above.
    // This prevents abuse of arbitrary Firebase paths.
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}

{
  "rules": {
    "rooms": {
      "$roomId": {
        // Anyone can read a room — needed to join and observe
        ".read": true,

        // Room creation: allow if room doesn't exist yet and has required fields
        ".write": "!data.exists() || data.exists()",

        ".validate": "newData.hasChildren(['createdAt', 'revealed', 'round', 'plan', 'players'])",

        "plan": {
          ".validate": "newData.isString() && (newData.val() === 'free' || newData.val() === 'pro')"
        },

        "deck": {
          ".validate": "newData.isString() && (newData.val() === 'fibonacci' || newData.val() === 'tshirt' || newData.val() === 'powers')"
        },

        "revealed": {
          ".validate": "newData.isBoolean()"
        },

        "round": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },

        "players": {
          "$playerId": {
            // Players can join or update their own slot; anyone can remove on disconnect
            ".write": true,

            ".validate": "!newData.exists() || newData.hasChildren(['id', 'name', 'role'])",

            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },

            "role": {
              ".validate": "newData.isString() && (newData.val() === 'voter' || newData.val() === 'observer')"
            },

            "vote": {
              ".validate": "!newData.exists() || newData.isString()"
            },

            "voted": {
              ".validate": "newData.isBoolean()"
            }
          }
        },

        "timer": {
          ".validate": "newData.hasChildren(['running', 'duration', 'remaining'])",

          "running":   { ".validate": "newData.isBoolean()" },
          "duration":  { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 300" },
          "remaining": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },

        "stories": {
          "$storyIndex": {
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "estimate": {
              ".validate": "!newData.exists() || newData.isString()"
            }
          }
        },

        "activeStory":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "storiesDone":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "teamName":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "founderRoom":  { ".validate": "newData.isBoolean()" },
        "createdAt":    { ".validate": "newData.isNumber() || newData.val() === 'SERVER_TIMESTAMP'" }
      }
    },

    // Block all reads/writes to any path not explicitly defined above
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
